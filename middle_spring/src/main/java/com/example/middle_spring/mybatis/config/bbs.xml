<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="Bbs"> <!-- 매퍼 네임스페이스명을 Bbs(사용자 정의명)로 설정 -->

   <!-- newbbs_no_seq 시퀀스로부터 다음번호값 가져오기 -->
   <select id="bbsNoSeq_Find" resultType="int">
      select
      newbbs_no_seq.nextval from dual
   </select>

   <!-- 첨부파일 정보만 빼고 tbl_newbbs 자료실 테이블에 레코드 저장 -->
   <insert id="bbs_in" parameterType="bbs">
      insert into
      tbl_newbbs(bbs_no,bbs_name,bbs_title,bbs_pwd,bbs_cont,bbs_ref,bbs_step,
      bbs_level,bbs_date) values(#{bbs_no}, #{bbs_name}, #{bbs_title},
      #{bbs_pwd},
      #{bbs_cont}, #{bbs_ref}, 0, 0, sysdate)
   </insert>

   <!-- 첨부파일이 있는 경우만 bbs_attached_file 컬럼 레코드를 7로 수정한다. 7이면 첨부파일이 있는 경우 -->
   <update id="bbs_attached_file" parameterType="java.util.Map">
      update tbl_newbbs
      set bbs_attached_file=#{attachedNumber} where bbs_no=#{bbs_no}
   </update>

   <!-- 한개 또는 다중파일 업로드한 파일정보 저장 -->
   <insert id="file_info"> <!-- parameterType 전달인자 타입은 생략가능 -->
      insert into tbl_newbbs_file(bbs_file_no, bbs_no, bbs_original_name,
      bbs_stored_name,
      bbs_file_path, bbs_file_size)
      values(file_no_seq.nextval, #{bbs_no},
      #{bbs_original_name},
      #{bbs_stored_name}, #{bbs_file_path},
      #{bbs_file_size})
   </insert>

   <!-- 검색 전후 레코드 개수 -->
   <select id="bbs_count" parameterType="bbs" resultType="int">
      <!-- parameterType은 전달인자 타입속성이고 생략가능하다. resultType은 반환타입 속성이고 생략불가. count()는 
         오라클에서 레코드 개수를 반환하는 함수이다. -->
      select count(bbs_no) from tbl_newbbs
      <where>
         <if test="find_field == ''"></if> <!-- 검색 전 총레코드 개수 조건 -->
         <if test="find_field == 'bbs_title'"> <!-- 제목 기준으로 검색한 경우 -->
            bbs_title like #{find_name} <!-- like는 ~와 비슷한 문자를 검색하는 검색 연산자 -->
         </if>
         <if test="find_field == 'bbs_cont'"> <!-- 내용 기준으로 검색한 경우 -->
            bbs_cont like #{find_name}
         </if>
      </where>
   </select>

   <!-- 검색 전후 페이징 목록 -->
   <select id="bbs_list" resultType="bbs">
      select * from (
      select rowNum rNum, bbs_no, bbs_name, bbs_title, bbs_hit, bbs_Ref, bbs_step,
      bbs_level, bbs_date, bbs_attached_file
      from (select * from tbl_newbbs
      <where>
         <if test="find_field ==''"></if> <!-- 검색을 안한 경우라서 총레코드 개수를 반환 -->
         <if test="find_field =='bbs_title'"> <!-- 제목 기준으로 검색한 경우 -->
            bbs_title like #{find_name} <!-- like는 ~와 비슷한 문자를 검색하는 검색연산자 -->
         </if>
         <if test="find_field=='bbs_cont'"> <!-- 내용 기준으로 검색한 경우 -->
            bbs_cont like #{find_name}
         </if>
      </where>
      order by bbs_ref desc, bbs_level asc)) where rNum &gt;= #{startrow}
      and rNum &lt;= #{endrow}
      <!-- &gt;은 >의 뜻이고, &lt;은 ~보다 <의 의미 -->
   </select>




</mapper>